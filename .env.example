# =====================================================
# EVM RESCUE TOOLKIT - ENV TEMPLATE
# Copy file ini ke ".env" lalu isi. JANGAN commit .env ke git!
# =====================================================

# --- Jaringan ---
CHAIN_ID=1                       # 1 = Mainnet, 11155111 = Sepolia (testnet, buat latihan dulu!), 137 = Polygon, 56 = BSC, 42161 = Arbitrum, 8453 = Base
RPC_HTTP_URL=https://eth-mainnet.g.alchemy.com/v2/xxxxx
RPC_WSS_URL=wss://eth-mainnet.g.alchemy.com/v2/xxxxx   # wajib untuk mode "listen" (passive sweeper)

# --- Untuk latihan/testing (Hardhat & dry-run) ---
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/xxxxx
ETHERSCAN_API_KEY=                # opsional, untuk verifikasi kontrak setelah deploy

# --- Wallet Utama ---
# Private key wallet yang bocor/beresiko drain (yang mau diselamatkan asetnya)
COMPROMISED_PRIVATE_KEY=0x...

# Private key wallet bersih yang membayar SEMUA gas (jangan pernah kirim ETH gas
# langsung ke compromised wallet di luar bundle, karena bisa disweep drainer)
SPONSOR_PRIVATE_KEY=0x...

# Alamat wallet aman tujuan akhir token/NFT hasil rescue
SAFE_DESTINATION_ADDRESS=0x...

# Private key acak KHUSUS untuk signing reputasi ke relay Flashbots
# (BUKAN wallet yang menyimpan dana, boleh wallet baru kosong, generate sekali & simpan)
FLASHBOTS_AUTH_SIGNER_KEY=0x...

# --- Target ---
TARGET_TOKEN_ADDRESS=0x...        # token ERC-20/721/1155 yang mau diselamatkan
CLAIM_CONTRACT_ADDRESS=0x...      # kontrak klaim (airdrop/unstake) jika ada, kosongkan jika tidak perlu klaim
CLAIM_CALLDATA=0x...              # calldata encoded untuk fungsi klaim, kosongkan jika tidak perlu

# --- Flashbots Relay ---
# Mainnet default: https://relay.flashbots.net
# Untuk chain lain (Polygon/BSC/Arbitrum/Base) Flashbots relay resmi TIDAK berlaku 1:1,
# lihat catatan RELAY ALTERNATIF di README.
FLASHBOTS_RELAY_URL=https://relay.flashbots.net

# --- Parameter Bundle ---
TARGET_BLOCK_OFFSET=1             # kirim bundle mulai dari (block saat ini + offset)
BLOCKS_TO_TRY=5                   # jumlah block berturut-turut dicoba jika belum masuk

# --- Rescuer.sol (opsional, isi setelah deploy via `npm run deploy`) ---
RESCUER_CONTRACT_ADDRESS=0x...

# --- Catatan mode claim (--amount / --all) ---
# Kalau token baru MUNCUL setelah tx klaim (mis. reward staking, airdrop manual),
# WAJIB isi --amount <jumlah> di CLI, supaya toolkit tidak salah kirim 0 token
# (balanceOf() sebelum klaim akan selalu 0). Gunakan --all HANYA kalau token
# SUDAH ADA di wallet saat command dijalankan.
